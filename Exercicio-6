# Inicializa as variáveis para armazenar os dados da pessoa mais velha
nome_mais_velho = ""
idade_mais_velha = -1  # Começa com um valor baixo para ser facilmente substituído

print("--- Cadastro de 5 Pessoas ---")

# Laço para repetir a leitura 5 vezes
for i in range(1, 6):
    print(f"\nPessoa {i}:")
    nome = input("Digite o nome: ")
    idade = int(input("Digite a idade: "))
    
    # Verifica se esta pessoa é a mais velha até agora
    if idade > idade_mais_velha:
        idade_mais_velha = idade
        nome_mais_velho = nome

# Exibe o resultado final esperado
print("\n--- Resultado ---")
print(f"A pessoa mais velha é {nome_mais_velho} com {idade_mais_velha} anos.")